# Instantiated once per connection to mcp-token.socket (Accept=yes).
# Each instance runs `mcp-token github` exactly once, with stdin/stdout
# wired directly to the accepted connection by systemd
# (StandardInput=socket / StandardOutput=socket) -- no shell, no
# buffering process, and no file on disk in between.
#
# StandardError=journal is load-bearing, not cosmetic: mcp-token's own
# error/warning/log output must never reach the socket, or a client
# reading "the token" could silently receive a mix of a token and
# diagnostic text. cmd/mcp-token/main.go writes only the token line to
# stdout for exactly this reason -- see the stdout-hygiene note in
# docs/architecture/mint-socket.md if that ever regresses.
#
# gnome-keyring-daemon.service is Ubuntu's standard user unit
# (/usr/lib/systemd/user/gnome-keyring-daemon.service), present in both
# WSL and GCP VM environments this is deployed to. It is a user-scope
# unit; do not point this Requires=/After= at a system-scope keyring
# unit (e.g. a hypothetical mcp-keyring.service) -- a user manager
# cannot resolve system units, and the dependency would fail the whole
# activation job, not just degrade it.
#
# ExecStart= and Environment= below are rewritten by
# scripts/install-mint-socket.sh to point at the resolved mcp-token
# binary path and its launcher.json; the placeholders are not runnable
# as committed and this file should not be enabled by hand.
#
# MCP_LAUNCHER_CONFIG is always written explicitly by the installer
# (never left unset to fall back on internal/config.DefaultPath()'s
# exe-adjacent rule), even when the resolved value is exactly the
# launcher.json next to the binary. Socket activation makes "which
# config" depend on wherever mcp-token's binary happened to be
# resolved from (~/.local/bin, ~/shiori/runtime, /opt/mcp-launcher/bin,
# ...); pinning it here means `systemctl --user cat mcp-token@.service`
# alone tells you which config a running instance uses, instead of
# also having to go check the binary's directory. See "Configuration
# file resolution" in docs/architecture/mint-socket.md.

[Unit]
Description=Mint a GitHub token for one mcp-token.socket connection
Requires=gnome-keyring-daemon.service
After=gnome-keyring-daemon.service

[Service]
Type=oneshot
StandardInput=socket
StandardOutput=socket
StandardError=journal
Environment=MCP_LAUNCHER_CONFIG=__MCP_LAUNCHER_CONFIG__
ExecStart=__MCP_TOKEN_BIN__ github
