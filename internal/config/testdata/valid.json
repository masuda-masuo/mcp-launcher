{
  "github": {
    "command": "github-mcp-server",
    "args": ["--stdio"],
    "env_keys": {
      "GITHUB_TOKEN": "mcp-launcher/github"
    }
  },
  "aws": {
    "command": "aws-mcp-server",
    "env_keys": {
      "AWS_ACCESS_KEY_ID": "mcp-launcher/aws-key",
      "AWS_SECRET_ACCESS_KEY": "mcp-launcher/aws-secret"
    }
  }
}
